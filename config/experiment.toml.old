[study]
name = "lightrag-vs-graphrag-thesis"
seed = 20260722
output_root = "results"
data_root = "data"
protocol_version = "1.0"

[common]
chunk_tokens = 600
chunk_overlap_tokens = 100
top_k = 5
temperature = 0.0
answer_prompt = "Answer only from the supplied context. If the context is insufficient, say so clearly. Cite source chunk identifiers in square brackets when possible."

[provider]
# Set the exact dated model IDs before `init`; do not use an unpinned alias.
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
generator_model = "gpt-5.6-luna"
embedding_model = "text-embedding-3-small"
judge_model = "gpt-5.6-terra"
region = "global"
pricing_date = "2026-07-22"
# USD per one million tokens. These are intentionally blank until the study's
# provider/model/price snapshot is selected and saved.
generator_input_per_million = 1.0
generator_output_per_million = 6.0
embedding_input_per_million = 0.02
judge_input_per_million = 2.5
judge_output_per_million = 15.0

[datasets.ultradomain_agriculture]
family = "ultradomain"
domain = "agriculture"
sample_size = 300
pilot_size = 20
source_url = "https://huggingface.co/datasets/TommyChien/UltraDomain"
licence = "Apache-2.0"

# [datasets.ultradomain_legal]
# family = "ultradomain"
# domain = "legal"
# sample_size = 300
# pilot_size = 20
# source_url = "https://huggingface.co/datasets/TommyChien/UltraDomain"
# licence = "Apache-2.0"

# [datasets.graphrag_bench_medical]
# family = "graphrag_bench"
# domain = "medical"
# sample_size = 300
# pilot_size = 20
# source_url = "https://huggingface.co/datasets/GraphRAG-Bench/GraphRAG-Bench"
# licence = "record during acquisition"

# [datasets.graphrag_bench_novel]
# family = "graphrag_bench"
# domain = "novel"
# sample_size = 300
# pilot_size = 20
# source_url = "https://huggingface.co/datasets/GraphRAG-Bench/GraphRAG-Bench"
