# [datasets.hotpotqa_fullwiki]
# family = "hotpotqa"
# domain = "fullwiki_validation"
# sample_size = 300
# pilot_size = 20
# source_url = "https://huggingface.co/datasets/hotpotqa/hotpot_qa"
# licence = "CC-BY-SA-4.0"

# [datasets.kevin_scott_podcasts]
# family = "kevin_scott"
# domain = "global_sensemaking"
# sample_size = 125
# pilot_size = 20
# source_url = "https://github.com/microsoft/graphrag-benchmarking-datasets"
# licence = "CDLA-Permissive-2.0"
# use_all_questions = true

[systems.naive]
kind = "native"

[systems.graphrag]
kind = "command"
index_checkpoint = "corpus"
# Requires the pinned `systems` extra; see scripts/graphrag_bridge.py.
index_command = ".venv/bin/python scripts/graphrag_bridge.py index --config config/experiment.toml --workspace {workspace} --input {input} --output {output}"
query_command = ".venv/bin/python scripts/graphrag_bridge.py query --config config/experiment.toml --workspace {workspace} --question {question} --method {method} --output {output}"

[systems.lightrag]
kind = "command"
index_checkpoint = "document"
chunk_llm_concurrency = 4 # Set to 1 for serial chunk extraction.
# Requires the pinned `systems` extra; see scripts/lightrag_bridge.py.
index_command = ".venv/bin/python scripts/lightrag_bridge.py index --config config/experiment.toml --workspace {workspace} --input {input} --output {output} {incremental_flag}"
query_command = ".venv/bin/python scripts/lightrag_bridge.py query --config config/experiment.toml --workspace {workspace} --question {question} --method {method} --output {output}"
